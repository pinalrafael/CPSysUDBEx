<Window x:Class="CPSysUDBCoreEx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPSysUDBCore - Exemplo"
        Height="650"
        Width="1050"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Cores -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Botão principal -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0,0,0"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource PrimaryDarkBrush}"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de perigo -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="{StaticResource DangerBrush}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource DangerDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EDF1F5"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="#EDF1F5"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- Cabeçalho do DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
        </Style>

        <!-- Linha do DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground"
                            Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Célula -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

    </Window.Resources>


    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- CABEÇALHO -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="CPSysUDBCore"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Exemplo de utilização da biblioteca"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#DCFCE7"
                    CornerRadius="15"
                    Padding="12,6"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#16A34A"
                             Margin="0,0,7,0"/>

                    <TextBlock Text="Banco conectado"
                               FontSize="12"
                               Foreground="#166534"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ÁREA DE OPERAÇÕES -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- NOVO REGISTRO -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Novo registro"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Insira os dados para adicionar um registro."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,15"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Nome"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtAddNome"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Valor"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtAddValor"
                                     Text="2.5"/>

                        </StackPanel>

                    </Grid>


                    <Grid Margin="0,15,0,0">

                        <CheckBox x:Name="chbUseFun"
                                  Content="Executar através de função"/>

                        <Button Content="Adicionar"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Click="btnNovo_Click"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ATUALIZAÇÃO -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Registro selecionado"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Selecione um registro na tabela para editar."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,15"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock Text="ID"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>

                            <Border Height="34"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">

                                <TextBlock x:Name="lblId"
                                           VerticalAlignment="Center"
                                           Padding="10,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                            </Border>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Nome"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtUpdateName"/>

                        </StackPanel>

                    </Grid>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">

                        <Button Content="Atualizar"
                                Style="{StaticResource PrimaryButton}"
                                Click="btnAtualizar_Click"/>

                        <Button Content="Excluir"
                                Style="{StaticResource DangerButton}"
                                Click="btnDeletar_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- TABELA -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- TÍTULO DA TABELA -->
                <Grid Grid.Row="0"
                      Margin="18,15,18,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Registros"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Dados armazenados no banco de dados"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Clique em um registro para selecioná-lo"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- DATA GRID -->
                <DataGrid x:Name="gvLista"
                          Grid.Row="1"
                          Margin="10,0,10,10"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseLeftButtonUp="gvLista_MouseLeftButtonUp"/>

            </Grid>

        </Border>


        <!-- STATUS -->
        <Border Grid.Row="6"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource PrimaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="lblMsg"
                               Text="Pronto."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <TextBlock x:Name="lblData"
                           Grid.Column="1"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>